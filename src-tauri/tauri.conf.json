{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jtoolsbox",
  "version": "1.0.0",
  "identifier": "com.neo.jtoolsbox",
  "build": {
    "beforeDevCommand": "npm run build:web:file-sharing:fast && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:all",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JToolsBox",
        "width": 800,
        "height": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 Jimmy",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
