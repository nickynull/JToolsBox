{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JToolsBox",
  "version": "1.1.0",
  "identifier": "com.jimmy.jtoolsbox",
  "build": {
    "beforeDevCommand": "npm run build:web:file-sharing:fast && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:all",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JToolsBox",
        "width": 800,
        "height": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Jimmy",
    "category": "Utility",
    "shortDescription": "JToolsBox 桌面工具集合",
    "longDescription": "JToolsBox 是一个基于 Tauri v2 + Vue 3 构建的桌面工具集合，内置局域网文件分享等实用功能。",
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese"]
      }
    },
    "copyright": "Copyright © 2026 Jimmy",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
