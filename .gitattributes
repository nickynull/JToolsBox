# 换行符统一：仓库内一律 LF
# 避免 Windows（core.autocrlf=true）与 macOS/Linux 协作时出现整文件 diff
* text=auto eol=lf

# 代码与文本显式声明（便于阅读，效果同上面的兜底规则）
*.rs    text eol=lf
*.ts    text eol=lf
*.vue   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf

# 二进制资源，禁止任何换行符转换与文本 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.bmp   binary
*.ico   binary
*.icns  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.exe   binary
*.dll   binary
*.pdb   binary
*.zip   binary

# Windows 脚本保持 CRLF（cmd/PowerShell 对 LF 更敏感）
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
